# ═══════════════════════════════════════════════════════════
# Z.ai Telegram Agent v15.0 - Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Z.ai API ───────────────────────────────────────────
ZAI_BASE_URL=https://api.z.ai
ZAI_API_KEY=your_zai_api_key_here
ZAI_CHAT_ID=your_chat_id_here
ZAI_TOKEN=your_zai_token_here
ZAI_USER_ID=your_zai_user_id_here

# ─── GitHub Integration ────────────────────────────────
GH_PAT=your_github_personal_access_token
GH_USERNAME=your_github_username

# ─── User Authorization ────────────────────────────────
ALLOWED_USERNAMES=your_telegram_username

# ─── Agent Configuration ───────────────────────────────
DEFAULT_MODEL=glm-5.1
MAX_CONCURRENT_OPS=3
MAX_MESSAGE_LENGTH=4000
