# ═══════════════════════════════════════════════════════════
# Z.ai Telegram Agent v16.0 - Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Z.ai API ───────────────────────────────────────────
ZAI_BASE_URL=https://z.ai/api/v1
ZAI_API_KEY=your_zai_api_key_here
ZAI_CHAT_ID=chat-your-chat-id
ZAI_TOKEN=your_jwt_token_here
ZAI_USER_ID=your_user_id_here

# ─── GitHub Integration ────────────────────────────────
GH_PAT=your_github_personal_access_token
GH_USERNAME=your_github_username

# ─── User Authorization ────────────────────────────────
ALLOWED_USERNAMES=your_telegram_username

# ─── Agent Configuration ───────────────────────────────
DEFAULT_MODEL=glm-4-flash
