# ═══════════════════════════════════════════════════════════
# Z.ai Telegram Agent v18.2 - Environment Configuration
# This bot runs ONLY on GitHub Actions
# Set these as GitHub Secrets in your repository settings
# ═══════════════════════════════════════════════════════════

# ─── Telegram Bot ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Z.ai API ───────────────────────────────────────────
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=your_zai_api_key_here
ZAI_CHAT_ID=chat-your-chat-id
ZAI_TOKEN=your_jwt_token_here
ZAI_USER_ID=your_user_id_here

# ─── OpenCode API (Free Models) ──────────────────────────
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/api/v1

# ─── GitHub Integration ────────────────────────────────
GH_PAT=your_github_personal_access_token
GH_USERNAME=your_github_username

# ─── User Authorization ────────────────────────────────
ALLOWED_USERNAMES=your_telegram_username

# ─── Agent Configuration ───────────────────────────────
DEFAULT_MODEL=glm-4-flash
MAX_SANDBOXES=3
